# PaaS runtime variables. This file is a template, NOT loaded automatically.
# Set real values in the panel's Runtime/Secret section, never in Build variables.
DJANGO_SETTINGS_MODULE=repair_desk.production_settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=app.example.ir,repairdesk-api
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.ir
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_MEDIA_ROOT=/data/media
# Only true when the API is internal and the trusted proxy replaces this header.
DJANGO_TRUST_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DB_NAME=repairdesk
DB_USER=repairdesk_app
DB_PASSWORD=REPLACE_WITH_THE_APPLICATION_USER_PASSWORD
DB_HOST=REPLACE_WITH_THE_INTERNAL_MYSQL_HOST
DB_PORT=3306
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2

# Notification provider: fake, smsir, or kavenegar
NOTIFICATION_PROVIDER=fake

# auto: fake is immediate, real providers use the worker
# worker: every provider uses the worker
# sync: intended only for development/debugging
NOTIFICATION_SEND_MODE=worker

# Customer-facing tracking page. Use a public HTTPS URL with real SMS.
PUBLIC_TRACKING_BASE_URL=https://app.example.ir/track

NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_DELAYS_SECONDS=60,300,900

# SMS.ir — required only when NOTIFICATION_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TIMEOUT_SECONDS=10
SMSIR_TEMPLATE_REPAIR_CREATED=
SMSIR_TEMPLATE_REPAIR_WAITING_FOR_PARTS=
SMSIR_TEMPLATE_REPAIR_READY=
SMSIR_TEMPLATE_REPAIR_CANCELLED=

# Kavenegar — required only when NOTIFICATION_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TIMEOUT_SECONDS=10
KAVENEGAR_TEMPLATE_REPAIR_CREATED=
KAVENEGAR_TEMPLATE_REPAIR_WAITING_FOR_PARTS=
KAVENEGAR_TEMPLATE_REPAIR_READY=
KAVENEGAR_TEMPLATE_REPAIR_CANCELLED=

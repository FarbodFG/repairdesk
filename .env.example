# Notification provider: fake, smsir, or kavenegar
NOTIFICATION_PROVIDER=fake

# auto: fake is immediate, real providers use the worker
# worker: every provider uses the worker
# sync: intended only for development/debugging
NOTIFICATION_SEND_MODE=auto

# Customer-facing tracking page. Use a public HTTPS URL with real SMS.
PUBLIC_TRACKING_BASE_URL=http://localhost:5173/track

NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_MAX_ATTEMPTS=4
NOTIFICATION_RETRY_DELAYS_SECONDS=60,300,900

# SMS.ir — required only when NOTIFICATION_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TIMEOUT_SECONDS=10
SMSIR_TEMPLATE_REPAIR_CREATED=
SMSIR_TEMPLATE_REPAIR_WAITING_FOR_PARTS=
SMSIR_TEMPLATE_REPAIR_READY=
SMSIR_TEMPLATE_REPAIR_CANCELLED=

# Kavenegar — required only when NOTIFICATION_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TIMEOUT_SECONDS=10
KAVENEGAR_TEMPLATE_REPAIR_CREATED=
KAVENEGAR_TEMPLATE_REPAIR_WAITING_FOR_PARTS=
KAVENEGAR_TEMPLATE_REPAIR_READY=
KAVENEGAR_TEMPLATE_REPAIR_CANCELLED=

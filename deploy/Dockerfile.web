# Optional reproducible image for platforms that build a Dockerfile from Git.
# It is an alternative way to populate the existing Nginx service, not a second
# frontend service to buy. Building needs more RAM than serving the result.
FROM node:22-bookworm-slim AS build
WORKDIR /web
RUN npm install --global pnpm@11.19.0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
ARG VITE_CURRENCY_LABEL
ENV VITE_API_BASE_URL=/api
ENV VITE_CURRENCY_LABEL=$VITE_CURRENCY_LABEL
RUN pnpm build

FROM nginx:stable-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
EXPOSE 8080
